{
  "info": {
    "name": "TreadX Hybrid Approach Testing",
    "description": "Test collection for the hybrid territory access implementation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "managerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "agentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "vendorToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login as Platform Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@treadx.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('adminToken', response.token);",
                  "    console.log('Admin token set:', response.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Sales Manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@treadx.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('managerToken', response.token);",
                  "    console.log('Manager token set:', response.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Sales Agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@treadx.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('agentToken', response.token);",
                  "    console.log('Agent token set:', response.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Security Context Testing",
      "item": [
        {
          "name": "Get Current User Info (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/test/current-user",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "test", "current-user"]
            }
          }
        },
        {
          "name": "Get Current User Info (Manager)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/test/current-user",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "test", "current-user"]
            }
          }
        },
        {
          "name": "Get Current User Info (Agent)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/test/current-user",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "test", "current-user"]
            }
          }
        },
        {
          "name": "Test Territory Access - N6B (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/test/territory-access/N6B",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "test", "territory-access", "N6B"]
            }
          }
        },
        {
          "name": "Test Territory Access - N5V (Manager)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/test/territory-access/N5V",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "test", "territory-access", "N5V"]
            }
          }
        },
        {
          "name": "Get Primary Territory (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/test/primary-territory",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "test", "primary-territory"]
            }
          }
        }
      ]
    },
    {
      "name": "Leads API Testing",
      "item": [
        {
          "name": "Get My Leads (Automatic) - Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads/my-leads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "leads", "my-leads"]
            }
          }
        },
        {
          "name": "Get My Leads (Automatic) - Manager",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads/my-leads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "leads", "my-leads"]
            }
          }
        },
        {
          "name": "Get My Leads (Automatic) - Agent",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads/my-leads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "leads", "my-leads"]
            }
          }
        },
        {
          "name": "Get Leads by Territory (Explicit) - N6B",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads/territories/N6B?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "leads", "territories", "N6B"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Leads by Status (Automatic) - PENDING",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads/my-leads/status?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "leads", "my-leads", "status"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        },
        {
          "name": "Get Leads by Territory and Status (Explicit) - N6B PENDING",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads/territories/N6B/status?status=PENDING&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "leads", "territories", "N6B", "status"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    }
  ]
} 